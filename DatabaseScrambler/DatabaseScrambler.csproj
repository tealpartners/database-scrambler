<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DatabaseScrambler</RootNamespace>
    <AssemblyName>DatabaseScrambler</AssemblyName>
    <Company>Dika</Company>
    <Product>DatabaseScrambler</Product>
    <Copyright>Copyright © Dika 2015</Copyright>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Microsoft Entra authentication (Authentication=Active Directory ...), split out of Microsoft.Data.SqlClient since 7.0 -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <!-- Pin the transitive dependency of Microsoft.Data.SqlClient, 9.0.x has known vulnerabilities -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.txt" />
    <EmbeddedResource Include="Scripts\*.sql" />
    <None Update="ScrambleConfiguration.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
